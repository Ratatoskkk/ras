      "description": "Flat raised panel with ruled heading.",
      "html": "<section class=\"ds-card\"><h2 class=\"ds-card-head\">Ready when you are</h2><div class=\"ds-card-body\">A following season can wait until the household chooses to start it.</div></section>",
      "css": ".ds-card{overflow:hidden;border:1px solid var(--border,#dbe5dd2b);border-radius:10px;background:var(--bg-elevated,#193036);color:var(--text,#f5f0e5)}.ds-card-head{margin:0;padding:16px 18px;border-bottom:1px solid var(--border,#dbe5dd2b);font:500 22px/1 \"Barlow Condensed\",\"Arial Narrow\",sans-serif}.ds-card-body{padding:18px;font:400 15px/1.5 \"Segoe UI\",sans-serif}.ds-card:focus-within{outline:2px solid var(--accent,#e0ad60);outline-offset:3px}"
    },
    {
      "name": "Showtime Listing",
      "kind": "custom",
      "refersTo": "schedule-panel",
      "description": "Ivory dated listing that opens Calendar detail.",
      "html": "<a class=\"ds-showtime\" href=\"#/calendar\"><strong class=\"ds-showtime-date\">27</strong><span class=\"ds-showtime-copy\"><strong>Upcoming release</strong><small>September · Open Calendar</small></span><span aria-hidden=\"true\">›</span></a>",
      "css": ".ds-showtime{display:grid;grid-template-columns:50px minmax(0,1fr) 16px;align-items:center;gap:18px;min-height:69px;padding:9px 18px;border:1px solid #c7c9b8;border-radius:10px;background:#f1ebdc;color:#173036;text-decoration:none;transition:transform .24s cubic-bezier(.2,.8,.2,1)}.ds-showtime:hover{transform:translateY(-2px);color:#89571e}.ds-showtime:focus-visible{outline:2px solid #9b622c;outline-offset:3px}.ds-showtime-date{font:500 37px/.85 \"Barlow Condensed\",\"Arial Narrow\",sans-serif;color:#9b622c}.ds-showtime-copy{display:grid;gap:3px;font:600 14px \"Segoe UI\",sans-serif}.ds-showtime-copy small{color:#5b6d69;font-size:12px;font-weight:400}"
    },
    {
      "name": "Status Pill",
